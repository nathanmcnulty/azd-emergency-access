{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "azd deployment validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "startedAt",
    "completedAt",
    "durationMs",
    "template",
    "mode",
    "requirements",
    "outcome",
    "summary",
    "checks",
    "nextSteps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "reportType": {
      "const": "azdDeploymentValidation"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "template": {
      "$ref": "#/$defs/template"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "mode": {
      "enum": [
        "plan",
        "verify",
        "delivery"
      ]
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "outcome": {
      "enum": [
        "planned",
        "passed",
        "passedWithWarnings",
        "failed"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "tenantId": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "resourceGroup": { "type": "string" },
        "azureCloud": { "type": "string" },
        "graphEnvironment": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "modules", "permissions"],
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "modules": { "type": "array", "items": { "type": "string" } },
        "permissions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "warning",
        "info",
        "skipped",
        "planned"
      ],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "planned": { "type": "integer", "minimum": 0 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "title",
        "status",
        "summary",
        "evidence",
        "durationMs",
        "sideEffect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "phase": {
          "enum": [
            "context",
            "infrastructure",
            "identity",
            "configuration",
            "security",
            "runtime",
            "delivery"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warning",
            "info",
            "skipped",
            "planned"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object"
        },
        "remediation": {
          "type": ["string", "null"]
        },
        "expected": {},
        "actual": {},
        "metadata": {
          "type": "object"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "sideEffect": {
          "enum": [
            "none",
            "readOnly",
            "negativeProbe",
            "syntheticDelivery"
          ]
        }
      }
    }
  }
}
