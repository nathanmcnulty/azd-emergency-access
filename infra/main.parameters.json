{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "deploymentMode": { "value": "${AZD_DEPLOYMENT_MODE}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "namePrefix": { "value": "${AZURE_ENV_NAME}" },
    "tags": { "value": { "azd-env-name": "${AZURE_ENV_NAME}" } },
    "emergencyAccessGroupObjectId": { "value": "${AZD_EMERGENCY_GROUP_ID=}" },
    "scheduleCron": { "value": "${AZD_SCHEDULE_CRON}" },
    "scheduleInterval": { "value": "${AZD_SCHEDULE_INTERVAL}" },
    "scheduleFrequency": { "value": "${AZD_SCHEDULE_FREQUENCY}" },
    "scheduleTimeZone": { "value": "${AZD_AUTOMATION_TIME_ZONE}" },
    "scheduleStartTime": { "value": "${AZD_AUTOMATION_START_TIME=}" },
    "sentinelWorkspaceName": { "value": "${AZD_SENTINEL_WORKSPACE_NAME=}" },
    "sentinelWorkspaceResourceGroup": { "value": "${AZD_SENTINEL_WORKSPACE_RESOURCE_GROUP=}" },
    "functionAuthClientId": { "value": "${AZD_FUNCTION_AUTH_CLIENT_ID=}" },
    "functionAuthAudience": { "value": "${AZD_FUNCTION_AUTH_AUDIENCE=}" },
    "sentinelServicePrincipalId": { "value": "${AZD_SENTINEL_SERVICE_PRINCIPAL_ID=}" },
    "sentinelAlertRuleId": { "value": "${AZD_SENTINEL_ALERT_RULE_ID=}" },
    "sentinelAutomationRuleId": { "value": "${AZD_SENTINEL_AUTOMATION_RULE_ID=}" },
    "enableSignInAlerts": { "value": "${AZD_ENABLE_SIGNIN_ALERTS}" },
    "signInLogWorkspaceName": { "value": "${AZD_SIGNIN_LOG_WORKSPACE_NAME=}" },
    "signInLogWorkspaceResourceGroup": { "value": "${AZD_SIGNIN_LOG_WORKSPACE_RESOURCE_GROUP=}" },
    "signInAlertEmail": { "value": "${AZD_SIGNIN_ALERT_EMAIL=}" },
    "enableSentinelActivityAlerts": { "value": "${AZD_ENABLE_SENTINEL_ACTIVITY_ALERTS}" },
    "sentinelTeamsWebhookUrl": { "value": "${AZD_SENTINEL_TEAMS_WEBHOOK_URL=}" },
    "sentinelTeamsDeliveryMode": { "value": "${AZD_SENTINEL_TEAMS_DELIVERY_MODE}" },
    "sentinelTeamsConnectionResourceId": { "value": "${AZD_SENTINEL_TEAMS_CONNECTION_RESOURCE_ID=}" },
    "sentinelTeamsTeamId": { "value": "${AZD_SENTINEL_TEAMS_TEAM_ID=}" },
    "sentinelTeamsChannelId": { "value": "${AZD_SENTINEL_TEAMS_CHANNEL_ID=}" },
    "sentinelOutlookConnectionResourceId": { "value": "${AZD_SENTINEL_OUTLOOK_CONNECTION_RESOURCE_ID=}" },
    "sentinelNotificationEmail": { "value": "${AZD_SENTINEL_NOTIFICATION_EMAIL=}" },
    "sentinelSignInRuleId": { "value": "${AZD_SENTINEL_SIGNIN_RULE_ID=}" },
    "sentinelAdminActivityRuleId": { "value": "${AZD_SENTINEL_ADMIN_ACTIVITY_RULE_ID=}" },
    "sentinelAccountChangeRuleId": { "value": "${AZD_SENTINEL_ACCOUNT_CHANGE_RULE_ID=}" },
    "sentinelNotificationAutomationRuleId": { "value": "${AZD_SENTINEL_NOTIFICATION_AUTOMATION_RULE_ID=}" },
    "emergencyUser1ObjectId": { "value": "${AZD_EMERGENCY_USER1_ID=}" },
    "emergencyUser2ObjectId": { "value": "${AZD_EMERGENCY_USER2_ID=}" }
  }
}
